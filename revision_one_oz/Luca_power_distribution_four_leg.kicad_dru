(version 1)
(rule "Review clearance" (constraint clearance (min 0.2mm)))
(rule "Review track width" (constraint track_width (min 0.5mm)))
(rule "Review drill" (constraint hole_size (min 0.3mm)))
(rule "Prototype annular ring" (constraint annular_width (min 0.254mm)))
(rule "Copper edge" (constraint edge_clearance (min 0.5mm)))
