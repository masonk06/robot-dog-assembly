# Local Python runtime installed for direct serial access.
.servo_tools/
__pycache__/
**/__pycache__/
*.pyc

# Editor and OS files.
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.kicad_prl

# Local environments, credentials, and generated training output.
.venv/
.venv-newton/
.venv-cuda/
venv/
.env
.env.*
!.env.example
*.pem
*.key
wandb/
runs/
checkpoints/
*.sif
.apptainer/
